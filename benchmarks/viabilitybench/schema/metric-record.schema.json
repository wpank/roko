{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vb.metric_record/1",
  "description": "One published number with its provenance, a row of metrics.json (S08 §5.5; B §6's MetricRecord plus the S08 and S09 fields). S10 renders only these records, and every one lists the run ids behind it.",
  "type": "object",
  "required": ["schema_version", "metric", "value", "n", "estimator", "experiment_id", "arms", "run_ids", "seeds", "commits", "config_hashes", "analysis_commit", "computed_at", "preregistered", "prereg_id", "blinded", "label_source", "cost_basis", "price_snapshot_id"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "vb.metric_record/1"},
    "metric": {"type": "string", "description": "e.g. vs_rate, usd_per_vs, pass_hat_k, false_green_rate"},
    "value": {"type": ["number", "null"], "description": "null when undefined, e.g. $/VS with no verified success"},
    "ci": {"type": "array", "minItems": 2, "items": {"type": "number"}, "description": "[low, high]"},
    "ci_method": {"type": "string", "description": "e.g. wilson, paired_bootstrap, stratified_bootstrap, none"},
    "n": {"type": "integer"},
    "estimator": {"type": "string"},
    "experiment_id": {"type": "string"},
    "arms": {"type": "array", "items": {"type": "string"}},
    "record_filter": {"type": "string", "description": "the exact filter over records.jsonl"},
    "run_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "seeds": {"type": "array", "items": {"type": "integer"}},
    "commits": {"type": "array", "items": {"type": "string"}},
    "config_hashes": {"type": "array", "items": {"type": "string"}},
    "analysis_commit": {"type": "string"},
    "computed_at": {"type": "string"},
    "preregistered": {"type": "boolean"},
    "prereg_id": {"type": ["string", "null"], "description": "S09's lock hash; null for descriptive analyses such as the pilot"},
    "blinded": {"type": "boolean"},
    "label_source": {"enum": ["vs_census", "vs_estimated", "visible_only"]},
    "cost_basis": {"enum": ["api_equiv_usd", "billed_usd", null], "description": "null for metrics that are not costs"},
    "price_snapshot_id": {"type": "string"},
    "ladder": {"enum": [1, 2, 3, 4, 5]},
    "envelope_level": {"type": ["integer", "null"]}
  }
}
