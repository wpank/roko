{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vb.task/1",
  "description": "The manifest of one generated task instance: task.json, which gen.py writes to its private --out directory, never into the agent's workdir (S08 §5.2 put it in DIR/.vb/, inside the workdir, where an agent would read its canary). It names the truth suite but never holds hidden inputs.",
  "type": "object",
  "required": ["schema_version", "instance_id", "family", "ladder", "latent_version", "generator_version", "seed", "knobs", "spec", "files_in_scope", "visible_verify", "visible_test_hashes", "planted_gaming", "recoverability", "truth_suite", "canary", "is_honeypot"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "vb.task/1"},
    "instance_id": {"type": "string", "description": "e.g. F4-l3-0017: family, ladder level, instance number"},
    "family": {"enum": ["F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8"]},
    "ladder": {"enum": [1, 2, 3, 4, 5], "description": "difficulty level ℓ1–ℓ5 (S08 §4.4)"},
    "latent_version": {"type": "string", "description": "v1, or v2 after a convention flip"},
    "generator_version": {"type": "string"},
    "seed": {"type": "integer"},
    "knobs": {"type": "object", "description": "the level's knob values (k_doc, k_ex, k_files, …); each generator defines its own"},
    "spec": {
      "type": "object",
      "description": "The spec variants. Every variant has a path and a sha256; the vague one also names the operator and levels that produced it (S07 D-v1).",
      "required": ["precise"],
      "properties": {
        "precise": {
          "type": "object",
          "required": ["path", "sha256"],
          "properties": {"path": {"type": "string"}, "sha256": {"type": "string"}}
        },
        "vague": {
          "type": "object",
          "required": ["path", "sha256", "operator", "levels"],
          "properties": {
            "path": {"type": "string"},
            "sha256": {"type": "string"},
            "operator": {"type": "string"},
            "levels": {"type": "array", "items": {"type": "string"}},
            "operator_version": {"type": "string"}
          }
        }
      },
      "additionalProperties": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string"},
          "operator": {"type": "string"},
          "levels": {"type": "array", "items": {"type": "string"}},
          "operator_version": {"type": "string"}
        }
      }
    },
    "files_in_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "visible_verify": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "the visible gate: commands the agent may see and run"},
    "visible_test_hashes": {"type": "object", "additionalProperties": {"type": "string"}, "description": "path -> sha256 of each visible test file, to detect test edits"},
    "planted_gaming": {"type": "array", "items": {"type": "string"}},
    "recoverability": {
      "type": "array",
      "minItems": 1,
      "description": "Every hidden requirement is stated in the precise spec or evidenced in the repo (S08 §4.2 (3)); an instance without this list is invalid.",
      "items": {
        "type": "object",
        "required": ["req", "evidence"],
        "properties": {
          "req": {"type": "string"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "truth_suite": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {"id": {"type": "string"}, "version": {"type": "string"}}
    },
    "canary": {"type": "string", "description": "the per-release canary GUID; any hit in a transcript or diff marks the run leak_suspected"},
    "is_honeypot": {"type": "boolean"}
  }
}
