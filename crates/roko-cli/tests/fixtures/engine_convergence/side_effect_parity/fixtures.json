        {"kind": "wave_completed", "seq": 11, "wave_index": 0, "elapsed_ms": 200},
        {"kind": "graph_completed", "seq": 12, "elapsed_ms": 250}
      ],
      "expected": {
        "provider_dispatch_count": 2,
        "git_mutation_count": 0,
        "feedback_sink_count": 0,
