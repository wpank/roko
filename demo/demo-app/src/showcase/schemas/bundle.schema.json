{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "showcase-bundle/1",
  "description": "A replay bundle's bundle.json (S10 §5.5).",
  "type": "object",
  "required": [
    "schema",
    "bundle_id",
    "kind",
    "simulated",
    "title",
    "created_at",
    "featured",
    "experiment_ids",
    "run_ids",
    "harness_commit",
    "dirty",
    "analysis_commit",
    "config_hashes",
    "price_snapshot_id",
    "models",
    "views",
    "cost_usd",
    "redaction",
    "files",
    "reproduce"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "showcase-bundle/1"},
    "bundle_id": {"type": "string"},
    "kind": {"enum": ["measured", "replay", "fixture"]},
    "simulated": {"const": false},
    "title": {"type": "string"},
    "created_at": {"type": "string"},
    "featured": {"type": "boolean"},
    "experiment_ids": {"type": "array", "items": {"type": "string"}},
    "run_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "harness_commit": {"type": "string"},
    "dirty": {"type": "boolean"},
    "analysis_commit": {"type": "string"},
    "config_hashes": {"type": "array", "items": {"type": "string"}},
    "price_snapshot_id": {"type": "string"},
    "models": {"type": "array", "items": {"type": "string"}},
    "views": {"type": "array", "items": {"enum": ["overview", "p1-head-to-head", "m4-audits"]}},
    "cost_usd": {"type": "number"},
    "redaction": {
      "type": "object",
      "required": ["transcripts", "prompts", "hidden_tests", "diffs"],
      "additionalProperties": false,
      "properties": {
        "transcripts": {"const": "excluded"},
        "prompts": {"const": "sha256"},
        "hidden_tests": {"const": "sha256"},
        "diffs": {"enum": ["included", "excluded"]}
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "schema", "sha256", "rows"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "schema": {"type": "string"},
          "sha256": {"type": "string"},
          "rows": {"type": "integer"}
        }
      }
    },
    "reproduce": {"type": "array", "items": {"type": "string"}}
  }
}
