{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "showcase-view/m4-audits/1",
  "description": "The M4 audit lottery (S10 §5.2); check ids are S05 §4.3's battery.",
  "type": "object",
  "required": [
    "schema",
    "claim",
    "visible_passes",
    "policy",
    "audited",
    "caught",
    "false_green",
    "gaming_rate",
    "detector",
    "by_check",
    "draws",
    "series",
    "metrics",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "showcase-view/m4-audits/1"},
    "claim": {
      "type": "object",
      "required": ["hypothesis", "state", "prereg_id", "planned_in", "text"],
      "additionalProperties": false,
      "properties": {
        "hypothesis": {"type": "string"},
        "state": {"enum": ["SUPPORTED", "NOT_SUPPORTED", "INCONCLUSIVE", "NOT_YET_MEASURED"]},
        "prereg_id": {"type": ["string", "null"]},
        "planned_in": {"type": "array", "items": {"type": "string"}},
        "text": {"type": "string"}
      }
    },
    "visible_passes": {"type": "integer"},
    "policy": {
      "type": "object",
      "required": ["pi_base", "pi_honeypot", "pi_gaming_prone"],
      "additionalProperties": false,
      "properties": {
        "pi_base": {"type": "number"},
        "pi_honeypot": {"type": "number"},
        "pi_gaming_prone": {"type": "number"}
      }
    },
    "audited": {"type": "integer"},
    "caught": {"type": "integer"},
    "false_green": {
      "type": ["object", "null"],
      "required": ["value", "ci", "metric_ref", "estimator", "ci_method", "n_eff", "bound"],
      "additionalProperties": false,
      "properties": {
        "value": {"type": ["number", "null"]},
        "ci": {
          "type": ["array", "null"],
          "minItems": 2,
          "items": {"type": "number"},
          "description": "[low, high]"
        },
        "metric_ref": {"type": "string"},
        "estimator": {"type": "string"},
        "ci_method": {"type": "string"},
        "n_eff": {"type": "number"},
        "bound": {"type": ["number", "null"]}
      }
    },
    "gaming_rate": {
      "type": ["object", "null"],
      "required": ["value", "ci", "metric_ref"],
      "additionalProperties": false,
      "properties": {
        "value": {"type": ["number", "null"]},
        "ci": {
          "type": ["array", "null"],
          "minItems": 2,
          "items": {"type": "number"},
          "description": "[low, high]"
        },
        "metric_ref": {"type": "string"}
      }
    },
    "detector": {
      "type": "object",
      "required": ["honeypots", "recall", "precision"],
      "additionalProperties": false,
      "properties": {
        "honeypots": {"type": "integer"},
        "recall": {
          "type": ["object", "null"],
          "required": ["value", "ci", "metric_ref"],
          "additionalProperties": false,
          "properties": {
            "value": {"type": ["number", "null"]},
            "ci": {
              "type": ["array", "null"],
              "minItems": 2,
              "items": {"type": "number"},
              "description": "[low, high]"
            },
            "metric_ref": {"type": "string"}
          }
        },
        "precision": {
          "type": ["object", "null"],
          "required": ["value", "ci", "metric_ref"],
          "additionalProperties": false,
          "properties": {
            "value": {"type": ["number", "null"]},
            "ci": {
              "type": ["array", "null"],
              "minItems": 2,
              "items": {"type": "number"},
              "description": "[low, high]"
            },
            "metric_ref": {"type": "string"}
          }
        }
      }
    },
    "by_check": {
      "type": "object",
      "required": ["A1_tamper", "A2_rerun", "B1_hidden", "B2_mutation", "B3_review"],
      "additionalProperties": false,
      "properties": {
        "A1_tamper": {
          "type": "object",
          "required": ["run", "failed"],
          "additionalProperties": false,
          "properties": {"run": {"type": "integer"}, "failed": {"type": "integer"}}
        },
        "A2_rerun": {
          "type": "object",
          "required": ["run", "failed"],
          "additionalProperties": false,
          "properties": {"run": {"type": "integer"}, "failed": {"type": "integer"}}
        },
        "B1_hidden": {
          "type": "object",
          "required": ["run", "failed"],
          "additionalProperties": false,
          "properties": {"run": {"type": "integer"}, "failed": {"type": "integer"}}
        },
        "B2_mutation": {
          "type": "object",
          "required": ["run", "mean_score"],
          "additionalProperties": false,
          "properties": {
            "run": {"type": "integer"},
            "mean_score": {
              "type": ["object", "null"],
              "required": ["value", "ci", "metric_ref"],
              "additionalProperties": false,
              "properties": {
                "value": {"type": ["number", "null"]},
                "ci": {
                  "type": ["array", "null"],
                  "minItems": 2,
                  "items": {"type": "number"},
                  "description": "[low, high]"
                },
                "metric_ref": {"type": "string"}
              }
            }
          }
        },
        "B3_review": {
          "type": "object",
          "required": ["run", "agree_with_B1"],
          "additionalProperties": false,
          "properties": {"run": {"type": "integer"}, "agree_with_B1": {"type": "integer"}}
        }
      }
    },
    "draws": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["audit_id", "attempt_key", "pi", "checks", "outcome", "feedback_actions"],
        "additionalProperties": false,
        "properties": {
          "audit_id": {"type": "string"},
          "attempt_key": {"type": "string"},
          "pi": {"type": "number"},
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "passed"],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": ["A1_tamper", "A2_rerun", "B1_hidden", "B2_mutation", "B3_review"]
                },
                "passed": {"type": "boolean"}
              }
            }
          },
          "outcome": {"enum": ["clean", "caught", "inconclusive"]},
          "feedback_actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["target", "from", "to"],
              "additionalProperties": false,
              "properties": {
                "target": {"type": "string"},
                "from": {"type": ["number", "string"]},
                "to": {"type": ["number", "string"]}
              }
            }
          }
        }
      }
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "estimate"],
        "additionalProperties": false,
        "properties": {
          "t": {"type": "string"},
          "estimate": {
            "type": "object",
            "required": ["value", "ci", "metric_ref"],
            "additionalProperties": false,
            "properties": {
              "value": {"type": ["number", "null"]},
              "ci": {
                "type": ["array", "null"],
                "minItems": 2,
                "items": {"type": "number"},
                "description": "[low, high]"
              },
              "metric_ref": {"type": "string"}
            }
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "metric_ref",
          "metric",
          "kind",
          "value",
          "ci",
          "ci_method",
          "n",
          "estimator",
          "arm",
          "envelope_level"
        ],
        "additionalProperties": false,
        "properties": {
          "metric_ref": {"type": "string"},
          "metric": {"type": "string"},
          "kind": {"enum": ["rate", "usd", "ratio", "count", "score"]},
          "value": {"type": ["number", "null"]},
          "ci": {
            "type": ["array", "null"],
            "minItems": 2,
            "items": {"type": "number"},
            "description": "[low, high]"
          },
          "ci_method": {"type": "string"},
          "n": {"type": "integer"},
          "estimator": {"type": "string"},
          "arm": {"type": ["string", "null"]},
          "envelope_level": {"type": ["integer", "null"]}
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "schema",
        "kind",
        "simulated",
        "bundle_id",
        "experiment_ids",
        "run_ids",
        "sources",
        "harness_commit",
        "dirty",
        "analysis_commit",
        "config_hashes",
        "price_snapshot_id",
        "models",
        "n",
        "seeds",
        "window",
        "estimator",
        "record_filter",
        "ci",
        "cost_usd",
        "generated_at",
        "reproduce"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "showcase-provenance/1"},
        "kind": {"enum": ["measured", "replay", "fixture"]},
        "simulated": {"const": false},
        "bundle_id": {"type": "string"},
        "experiment_ids": {"type": "array", "items": {"type": "string"}},
        "run_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "schema", "sha256", "rows", "simulated", "sha256_verified"],
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string"},
              "schema": {"type": "string"},
              "sha256": {"type": "string"},
              "rows": {"type": "integer"},
              "simulated": {"const": false},
              "sha256_verified": {
                "type": "boolean",
                "description": "set by the loader; bundles store false"
              }
            }
          }
        },
        "harness_commit": {"type": "string"},
        "dirty": {"type": "boolean"},
        "analysis_commit": {"type": "string"},
        "config_hashes": {"type": "array", "items": {"type": "string"}},
        "price_snapshot_id": {"type": "string"},
        "models": {"type": "array", "items": {"type": "string"}},
        "n": {"type": "integer"},
        "seeds": {"type": "array", "items": {"type": "integer"}},
        "window": {
          "type": "object",
          "required": ["from", "to"],
          "additionalProperties": false,
          "properties": {"from": {"type": "string"}, "to": {"type": "string"}}
        },
        "estimator": {"type": "string"},
        "record_filter": {"type": "string"},
        "ci": {
          "type": "object",
          "required": ["method", "strata", "level", "resamples"],
          "additionalProperties": false,
          "properties": {
            "method": {"type": "string"},
            "strata": {"type": "array", "items": {"type": "string"}},
            "level": {"type": "number"},
            "resamples": {"type": ["integer", "null"]}
          }
        },
        "cost_usd": {"type": "number"},
        "generated_at": {"type": "string"},
        "reproduce": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
