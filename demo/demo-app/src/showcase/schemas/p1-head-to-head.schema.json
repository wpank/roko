{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "showcase-view/p1-head-to-head/1",
  "description": "Cheap + harness vs frontier-direct (S10 §5.2): three arms plus the frontier·roko probe, never 2×2.",
  "type": "object",
  "required": ["schema", "claim", "arms", "pareto", "envelope", "metrics", "provenance"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "showcase-view/p1-head-to-head/1"},
    "claim": {
      "type": "object",
      "required": ["hypothesis", "state", "prereg_id", "planned_in", "text"],
      "additionalProperties": false,
      "properties": {
        "hypothesis": {"type": "string"},
        "state": {"enum": ["SUPPORTED", "NOT_SUPPORTED", "INCONCLUSIVE", "NOT_YET_MEASURED"]},
        "prereg_id": {"type": ["string", "null"]},
        "planned_in": {"type": "array", "items": {"type": "string"}},
        "text": {"type": "string"}
      }
    },
    "arms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "arm",
          "label",
          "tier",
          "harness",
          "role",
          "note",
          "models",
          "status",
          "reason",
          "n_tasks",
          "n_trials",
          "resolve",
          "usd_per_verified",
          "cost_source",
          "pass_hat_k",
          "outcome_sd"
        ],
        "additionalProperties": false,
        "properties": {
          "arm": {"type": "string"},
          "label": {"type": "string"},
          "tier": {"enum": ["cheap", "frontier"]},
          "harness": {"enum": ["direct", "roko"]},
          "role": {"enum": ["arm", "probe", "extra"]},
          "note": {"type": ["string", "null"]},
          "models": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["run", "not_run"]},
          "reason": {"type": ["string", "null"]},
          "n_tasks": {"type": "integer"},
          "n_trials": {"type": "integer"},
          "resolve": {
            "type": ["object", "null"],
            "required": ["value", "ci", "metric_ref"],
            "additionalProperties": false,
            "properties": {
              "value": {"type": ["number", "null"]},
              "ci": {
                "type": ["array", "null"],
                "minItems": 2,
                "items": {"type": "number"},
                "description": "[low, high]"
              },
              "metric_ref": {"type": "string"}
            }
          },
          "usd_per_verified": {
            "type": ["object", "null"],
            "required": ["value", "ci", "metric_ref"],
            "additionalProperties": false,
            "properties": {
              "value": {"type": ["number", "null"]},
              "ci": {
                "type": ["array", "null"],
                "minItems": 2,
                "items": {"type": "number"},
                "description": "[low, high]"
              },
              "metric_ref": {"type": "string"}
            }
          },
          "cost_source": {"enum": ["provider_usage", "cli_usage", null]},
          "pass_hat_k": {
            "type": ["object", "null"],
            "required": ["1", "3", "5"],
            "additionalProperties": false,
            "properties": {
              "1": {
                "type": "object",
                "required": ["value", "ci", "metric_ref"],
                "additionalProperties": false,
                "properties": {
                  "value": {"type": ["number", "null"]},
                  "ci": {
                    "type": ["array", "null"],
                    "minItems": 2,
                    "items": {"type": "number"},
                    "description": "[low, high]"
                  },
                  "metric_ref": {"type": "string"}
                }
              },
              "3": {
                "type": "object",
                "required": ["value", "ci", "metric_ref"],
                "additionalProperties": false,
                "properties": {
                  "value": {"type": ["number", "null"]},
                  "ci": {
                    "type": ["array", "null"],
                    "minItems": 2,
                    "items": {"type": "number"},
                    "description": "[low, high]"
                  },
                  "metric_ref": {"type": "string"}
                }
              },
              "5": {
                "type": "object",
                "required": ["value", "ci", "metric_ref"],
                "additionalProperties": false,
                "properties": {
                  "value": {"type": ["number", "null"]},
                  "ci": {
                    "type": ["array", "null"],
                    "minItems": 2,
                    "items": {"type": "number"},
                    "description": "[low, high]"
                  },
                  "metric_ref": {"type": "string"}
                }
              }
            }
          },
          "outcome_sd": {
            "type": ["object", "null"],
            "required": ["value", "ci", "metric_ref"],
            "additionalProperties": false,
            "properties": {
              "value": {"type": ["number", "null"]},
              "ci": {
                "type": ["array", "null"],
                "minItems": 2,
                "items": {"type": "number"},
                "description": "[low, high]"
              },
              "metric_ref": {"type": "string"}
            }
          }
        }
      }
    },
    "pareto": {
      "type": "object",
      "required": ["x", "y", "frontier_arms"],
      "additionalProperties": false,
      "properties": {
        "x": {"const": "usd_per_verified"},
        "y": {"const": "resolve"},
        "frontier_arms": {"type": "array", "items": {"type": "string"}}
      }
    },
    "envelope": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "envelope_level",
          "label",
          "n_tasks",
          "cheap_resolve",
          "frontier_resolve",
          "resolve_ratio",
          "usd_ratio",
          "verdict"
        ],
        "additionalProperties": false,
        "properties": {
          "envelope_level": {"type": ["integer", "null"]},
          "label": {"type": "string"},
          "n_tasks": {"type": "integer"},
          "cheap_resolve": {
            "type": ["object", "null"],
            "required": ["value", "ci", "metric_ref"],
            "additionalProperties": false,
            "properties": {
              "value": {"type": ["number", "null"]},
              "ci": {
                "type": ["array", "null"],
                "minItems": 2,
                "items": {"type": "number"},
                "description": "[low, high]"
              },
              "metric_ref": {"type": "string"}
            }
          },
          "frontier_resolve": {
            "type": ["object", "null"],
            "required": ["value", "ci", "metric_ref"],
            "additionalProperties": false,
            "properties": {
              "value": {"type": ["number", "null"]},
              "ci": {
                "type": ["array", "null"],
                "minItems": 2,
                "items": {"type": "number"},
                "description": "[low, high]"
              },
              "metric_ref": {"type": "string"}
            }
          },
          "resolve_ratio": {
            "type": ["object", "null"],
            "required": ["value", "ci", "metric_ref"],
            "additionalProperties": false,
            "properties": {
              "value": {"type": ["number", "null"]},
              "ci": {
                "type": ["array", "null"],
                "minItems": 2,
                "items": {"type": "number"},
                "description": "[low, high]"
              },
              "metric_ref": {"type": "string"}
            }
          },
          "usd_ratio": {
            "type": ["object", "null"],
            "required": ["value", "ci", "metric_ref"],
            "additionalProperties": false,
            "properties": {
              "value": {"type": ["number", "null"]},
              "ci": {
                "type": ["array", "null"],
                "minItems": 2,
                "items": {"type": "number"},
                "description": "[low, high]"
              },
              "metric_ref": {"type": "string"}
            }
          },
          "verdict": {"enum": ["within_target", "frontier_wins", "inconclusive", "not_measured"]}
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "metric_ref",
          "metric",
          "kind",
          "value",
          "ci",
          "ci_method",
          "n",
          "estimator",
          "arm",
          "envelope_level"
        ],
        "additionalProperties": false,
        "properties": {
          "metric_ref": {"type": "string"},
          "metric": {"type": "string"},
          "kind": {"enum": ["rate", "usd", "ratio", "count", "score"]},
          "value": {"type": ["number", "null"]},
          "ci": {
            "type": ["array", "null"],
            "minItems": 2,
            "items": {"type": "number"},
            "description": "[low, high]"
          },
          "ci_method": {"type": "string"},
          "n": {"type": "integer"},
          "estimator": {"type": "string"},
          "arm": {"type": ["string", "null"]},
          "envelope_level": {"type": ["integer", "null"]}
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "schema",
        "kind",
        "simulated",
        "bundle_id",
        "experiment_ids",
        "run_ids",
        "sources",
        "harness_commit",
        "dirty",
        "analysis_commit",
        "config_hashes",
        "price_snapshot_id",
        "models",
        "n",
        "seeds",
        "window",
        "estimator",
        "record_filter",
        "ci",
        "cost_usd",
        "generated_at",
        "reproduce"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "showcase-provenance/1"},
        "kind": {"enum": ["measured", "replay", "fixture"]},
        "simulated": {"const": false},
        "bundle_id": {"type": "string"},
        "experiment_ids": {"type": "array", "items": {"type": "string"}},
        "run_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "schema", "sha256", "rows", "simulated", "sha256_verified"],
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string"},
              "schema": {"type": "string"},
              "sha256": {"type": "string"},
              "rows": {"type": "integer"},
              "simulated": {"const": false},
              "sha256_verified": {
                "type": "boolean",
                "description": "set by the loader; bundles store false"
              }
            }
          }
        },
        "harness_commit": {"type": "string"},
        "dirty": {"type": "boolean"},
        "analysis_commit": {"type": "string"},
        "config_hashes": {"type": "array", "items": {"type": "string"}},
        "price_snapshot_id": {"type": "string"},
        "models": {"type": "array", "items": {"type": "string"}},
        "n": {"type": "integer"},
        "seeds": {"type": "array", "items": {"type": "integer"}},
        "window": {
          "type": "object",
          "required": ["from", "to"],
          "additionalProperties": false,
          "properties": {"from": {"type": "string"}, "to": {"type": "string"}}
        },
        "estimator": {"type": "string"},
        "record_filter": {"type": "string"},
        "ci": {
          "type": "object",
          "required": ["method", "strata", "level", "resamples"],
          "additionalProperties": false,
          "properties": {
            "method": {"type": "string"},
            "strata": {"type": "array", "items": {"type": "string"}},
            "level": {"type": "number"},
            "resamples": {"type": ["integer", "null"]}
          }
        },
        "cost_usd": {"type": "number"},
        "generated_at": {"type": "string"},
        "reproduce": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
