{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "showcase-provenance/1",
  "description": "The provenance envelope on every showcase read model (S10 §5.1).",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "simulated",
    "bundle_id",
    "experiment_ids",
    "run_ids",
    "sources",
    "harness_commit",
    "dirty",
    "analysis_commit",
    "config_hashes",
    "price_snapshot_id",
    "models",
    "n",
    "seeds",
    "window",
    "estimator",
    "record_filter",
    "ci",
    "cost_usd",
    "generated_at",
    "reproduce"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "showcase-provenance/1"},
    "kind": {"enum": ["measured", "replay", "fixture"]},
    "simulated": {"const": false},
    "bundle_id": {"type": "string"},
    "experiment_ids": {"type": "array", "items": {"type": "string"}},
    "run_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "schema", "sha256", "rows", "simulated", "sha256_verified"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "schema": {"type": "string"},
          "sha256": {"type": "string"},
          "rows": {"type": "integer"},
          "simulated": {"const": false},
          "sha256_verified": {
            "type": "boolean",
            "description": "set by the loader; bundles store false"
          }
        }
      }
    },
    "harness_commit": {"type": "string"},
    "dirty": {"type": "boolean"},
    "analysis_commit": {"type": "string"},
    "config_hashes": {"type": "array", "items": {"type": "string"}},
    "price_snapshot_id": {"type": "string"},
    "models": {"type": "array", "items": {"type": "string"}},
    "n": {"type": "integer"},
    "seeds": {"type": "array", "items": {"type": "integer"}},
    "window": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {"from": {"type": "string"}, "to": {"type": "string"}}
    },
    "estimator": {"type": "string"},
    "record_filter": {"type": "string"},
    "ci": {
      "type": "object",
      "required": ["method", "strata", "level", "resamples"],
      "additionalProperties": false,
      "properties": {
        "method": {"type": "string"},
        "strata": {"type": "array", "items": {"type": "string"}},
        "level": {"type": "number"},
        "resamples": {"type": ["integer", "null"]}
      }
    },
    "cost_usd": {"type": "number"},
    "generated_at": {"type": "string"},
    "reproduce": {"type": "array", "items": {"type": "string"}}
  }
}
