#!/usr/bin/env python3
"""Deterministic stand-in for the `claude` CLI, used by the live checks.

Roko's claude_cli provider runs `<command> --print --output-format stream-json
...` with the prompt on stdin and reads the answer from the stream-json events
it prints. The checks point `[providers.claude_cli] command` at this file so a
real plan run completes in seconds at no cost.

  * PRD plan-generation prompts get a canned one-task tasks.toml whose verify
    step compiles and runs a hello-world Rust program.
  * Old-format plan regeneration prompts get a valid modern plan, so a check
    can tell whether generation rewrote plans it was not asked to touch.
  * Revision prompts ("Revise the plan below", with the current plan in a
    fenced toml block) get that plan back with task T99 added; feedback
    containing BREAK makes T99 depend on a task that does not exist.
  * Every other prompt is a task: `SLOW <n>` sleeps n seconds first, then each
    `ARTIFACT <path>` named in the prompt is written (a `.rs` path gets a
    hello-world program).

Every call reports provider usage, so dashboards see non-zero tokens and cost.
Each call is appended to `.roko/fake-claude.log` in the working directory.
"""
import json
import os
import re
import sys
import time

prompt = sys.stdin.read()


def log(mode, detail=""):
    try:
        os.makedirs(".roko", exist_ok=True)
        with open(os.path.join(".roko", "fake-claude.log"), "a") as fh:
            fh.write(f"{time.time():.3f} {mode} {detail}\n")
    except OSError:
        pass


def emit(text):
    print(json.dumps({"type": "assistant",
                      "message": {"content": [{"type": "text", "text": text}]}}))
    print(json.dumps({"type": "result", "subtype": "success", "is_error": False,
                      "result": text, "total_cost_usd": 0.0012,
                      "usage": {"input_tokens": 120, "output_tokens": 30,
                                "cache_read_input_tokens": 0,
                                "cache_creation_input_tokens": 0}}))
    sys.stdout.flush()


if "Regenerate the plan at" in prompt:
    # The real agent rewrites tasks.toml in place, so the fake does too.
    match = re.search(r"Regenerate the plan at (\S+/tasks\.toml)", prompt)
    tasks_path = match.group(1) if match else None
    plan_id = os.path.basename(os.path.dirname(tasks_path)) if tasks_path else "regenerated"
    log("regenerate", plan_id)
    plan = f'''[meta]
plan = "{plan_id}"
total = 1
done = 0
status = "ready"
max_parallel = 1

[[task]]
id = "T01"
title = "Regenerated by the fake agent"
description = "Regenerated task."
status = "ready"
role = "implementer"
tier = "mechanical"
model_hint = "claude-sonnet-4-6"
files = ["README.md"]
depends_on = []

[task.context]
read_files = [{{ path = "README.md", why = "fixture" }}]

[[task.verify]]
phase = "structural"
command = "true"
fail_msg = "never fails"
'''
    if tasks_path:
        with open(tasks_path, "w") as fh:
            fh.write(plan)
    emit("Rewrote " + (tasks_path or "nothing") + ".")
    sys.exit(0)

if "Revise the plan below" in prompt:
    # Return the current plan (the prompt's fenced toml block) with one task added.
    # Feedback containing BREAK yields a dependency on a task that does not exist.
    match = re.search(r"```toml\n(.*?)```", prompt, re.S)
    current = match.group(1) if match else ""
    dep = '"NOPE"' if "BREAK" in prompt else ""
    log("revise", "broken" if dep else "ok")
    revised = re.sub(r"(?m)^total = (\d+)",
                     lambda m: f"total = {int(m.group(1)) + 1}", current.rstrip() + "\n", count=1)
    revised += f'''
[[task]]
id = "T99"
title = "Added by revision"
description = "Write the revision's file. ARTIFACT out/revised.txt"
status = "ready"
role = "implementer"
tier = "focused"
model_hint = "claude-sonnet-4-6"
files = ["out/revised.txt"]
depends_on = [{dep}]

[task.context]
read_files = [{{ path = "README.md", why = "fixture" }}]

[[task.verify]]
phase = "structural"
command = "test -f out/revised.txt"
fail_msg = "out/revised.txt was not written"
'''
    emit("```toml\n" + revised + "```\n")
    sys.exit(0)

if "Generate an implementation plan" in prompt:
    match = re.search(r"Plan slug \(use exactly in meta\.plan\): (\S+)", prompt)
    slug = match.group(1) if match else "generated-plan"
    log("generate", slug)
    plan = f'''[meta]
plan = "{slug}"
total = 1
done = 0
status = "ready"
max_parallel = 1

[[task]]
id = "T01"
title = "Write the hello world program"
description = "Create hello/main.rs, a Rust program that prints hello world. ARTIFACT hello/main.rs"
status = "ready"
role = "implementer"
tier = "mechanical"
files = ["hello/main.rs"]
depends_on = []

[[task.verify]]
phase = "build"
command = "rustc hello/main.rs -o hello/hello-bin && ./hello/hello-bin | grep -q 'hello world'"
fail_msg = "the program did not print hello world"
'''
    emit("```toml\n" + plan + "```\n")
    sys.exit(0)

slow = re.search(r"SLOW (\d+)", prompt)
if slow:
    time.sleep(int(slow.group(1)))
artifacts = list(dict.fromkeys(re.findall(r"ARTIFACT ([\w./-]+)", prompt)))
for path in artifacts:
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path, "w") as fh:
        if path.endswith(".rs"):
            fh.write('fn main() {\n    println!("hello world");\n}\n')
        else:
            fh.write(path + "\n")
log("task", " ".join(artifacts))
emit("Wrote the requested artifacts.")
